// ProActing database schema.
// Postgres, hosted on Neon - the models never moved when this switched
// over from the original SQLite dev datasource, exactly as planned.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  // "CANDIDATE" | "ADMIN" - plain string for the same SQLite-has-no-enums
  // reason as PracticeQuestion.category; validated in src/lib/auth.ts.
  role         String   @default("CANDIDATE")
  // Account-level kill switch, separate from plan/role - an admin can
  // restrict access without touching what plan the candidate is on or
  // deleting their data. Enforced in src/lib/auth.ts (blocks new logins)
  // and src/proxy.ts (blocks an already-issued session's further use,
  // checked fresh from the database on every matched request rather than
  // trusting anything baked into the JWT).
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile             Profile?
  practiceAttempts    PracticeAttempt[]
  practiceRecordings  PracticeRecording[]
  mockTestSessions    MockTestSession[]
  conversationSessions ConversationSession[]
  coachMessages       CoachMessage[]
  subscription        Subscription?
  usageEvents         UsageEvent[]
  passwordResetTokens PasswordResetToken[]
}

// Kept separate from User so Phase 3+ (practice/assessment data) can extend
// the candidate's profile without touching the auth-critical User model.
model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetRole String?
  bio        String?

  updatedAt DateTime @updatedAt
}

// category/difficulty/type are plain strings, not Prisma enums, because the
// SQLite connector does not support native enums. Valid values are defined
// once in src/lib/practice-taxonomy.ts and validated there at the app layer -
// swapping to Postgres later can upgrade these to real enums without moving
// any data.
model PracticeQuestion {
  id         String @id @default(cuid())
  category   String
  difficulty String
  type       String

  prompt   String
  passage  String? // reading/listening passage, or the customer's opening message for roleplay scenarios
  options  String? // JSON-encoded array of choice strings, for multiple choice
  correctAnswer  String? // matches one of `options`; only for objectively-gradable question types
  expectedAnswer String? // reference/ideal answer for open-ended or voice prompts (e.g. the exact sentence to read aloud, or a model response) - not auto-graded, shown to a future human/AI reviewer
  explanation    String? // shown after answering, real educational content

  timeLimitSeconds Int
  scoringCriteria  String? // human-readable description, used once AI scoring (Phase 8+) is wired in

  // "SEEDED" (hand-authored, prisma/seed*.mjs) | "AI_GENERATED" (Phase 18 -
  // a candidate requested a fresh scenario on a topic). Once created, an
  // AI-generated question is a real, permanent, reusable PracticeQuestion
  // row - identical in every other respect to a seeded one.
  source           String @default("SEEDED")
  estimatedCostUsd Float? // only set for source = "AI_GENERATED"

  // Soft-disable, not deletion - a question with existing attempts can't
  // be hard-deleted (see the FK-protected admin DELETE route), so this is
  // the only way to pull a bad question out of rotation. Every question-
  // selection query (practice, mock tests, interview simulation) filters
  // on this; an inactive question simply stops being served, permanently
  // or temporarily, without losing its attempt history.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  attempts             PracticeAttempt[]
  conversationSessions ConversationSession[]

  @@index([category, difficulty])
  @@index([category, difficulty, isActive])
}

model PracticeAttempt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionId String
  question   PracticeQuestion @relation(fields: [questionId], references: [id])

  category   String
  difficulty String

  responseText     String?
  recordingId      String?
  recording        PracticeRecording? @relation(fields: [recordingId], references: [id])
  isCorrect        Boolean? // null when the question type has no deterministic answer (e.g. interview prompts, voice recordings)
  score            Int? // 0-100; null until scored - never fabricated
  timeTakenSeconds Int

  // Set only when this attempt was answered inside a proctored mock test
  // (Phase 12), so results can be grouped per-session; null for ordinary
  // solo practice attempts, which use the exact same table and scoring path.
  mockTestSessionId String?
  mockTestSession    MockTestSession? @relation(fields: [mockTestSessionId], references: [id])

  createdAt DateTime @default(now())

  analysis SpeechAnalysis?

  @@index([userId, createdAt])
  @@index([userId, category])
  @@index([mockTestSessionId])
}

// Real, on-demand analysis of one voice attempt's recording - triggered only
// when a candidate views their results, not automatically for every
// recording, so we never pay for transcription/AI on attempts nobody
// reviews. Deterministic fields are computed by application code; the AI
// fields are a separate, clearly-labeled JSON blob.
model SpeechAnalysis {
  id        String          @id @default(cuid())
  attemptId String          @unique
  attempt   PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  transcript       String
  wordCount        Int
  durationSeconds  Float
  wpm              Float
  paceClassification String
  fillerCount      Int
  fillerBreakdown  String // JSON: { word: count }
  repetitionCount  Int
  repetitionExamples String // JSON array of strings
  longPauses       String // JSON array of {afterText, beforeText, gapSeconds, atSeconds}
  // Real per-segment {start, end, text} timestamps from the transcription
  // provider (Groq's verbose_json gives these for free - already computed
  // for longPauses above, just never persisted for playback until Phase 9).
  // Nullable so pre-existing rows analyzed before this field existed don't
  // need a backfill - the UI falls back to plain text for those.
  segmentsJson String?

  aiAnalysisJson String // full VoiceAnalysisResult, as JSON

  transcriptionProvider String
  transcriptionModel    String
  analysisProvider      String
  analysisModel         String
  estimatedCostUsd      Float

  // "Improve My Answer" (Phase 6) - a separate, explicitly-requested AI
  // call, cached the same on-demand way as the analysis itself: null until
  // asked for, generated once, never re-paid on a later view.
  improvedAnswerJson    String?
  improvedAnswerCostUsd Float?

  createdAt DateTime @default(now())
}

// A candidate's own voice recording for a practice attempt. Stored on local
// disk under uploads/ (gitignored) for this dev stage - swapping to S3/GCS
// later is a storage-layer change only, not a schema change: filePath
// becomes a storage key, everything else stays the same.
model PracticeRecording {
  id              String @id @default(cuid())
  userId          String
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  filePath        String
  mimeType        String
  durationSeconds Int?
  createdAt       DateTime @default(now())

  attempts         PracticeAttempt[]
  conversationTurns ConversationTurn[]

  @@index([userId])
}

// A candidate's run through one MockTestTemplate. Anchors both the
// live-proctoring events (Phase 7) and every question attempt answered
// during the test (Phase 12) - real persistence for both.
model MockTestSession {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String?
  template   MockTestTemplate? @relation(fields: [templateId], references: [id])
  startedAt  DateTime         @default(now())
  endedAt    DateTime?

  events      ProctoringEvent[]
  attempts    PracticeAttempt[]
  scoreReport ScoreReport?
  resultsReport ResultsReport?

  @@index([userId, startedAt])
}

// Rule-based score breakdown for one mock test session (Phase 13). Cheap
// to (re)compute - pure aggregation of already-persisted data, no AI call
// of its own - so unlike SpeechAnalysis this is recomputed fresh on every
// request rather than only-once-cached; the row is kept as an audit trail
// of what was shown and when.
model ScoreReport {
  id                String          @id @default(cuid())
  mockTestSessionId String          @unique
  mockTestSession   MockTestSession @relation(fields: [mockTestSessionId], references: [id], onDelete: Cascade)

  overallScore      Int?
  categoryScoresJson String

  computedAt DateTime @default(now())
}

// Narrative coaching report for one mock test session (Phase 14). Unlike
// ScoreReport, this DOES call an AI model (text-only, over the already-
// computed category scores and per-response notes - never raw audio again),
// so it is generated only on explicit candidate request and cached forever
// once created, the same on-demand/idempotent/cached discipline as
// SpeechAnalysis. The model is asked to synthesize and ground claims in the
// data it's given, never to invent a new score - overallScore/category
// numbers it echoes back must match what ScoreReport already computed.
model ResultsReport {
  id                String          @id @default(cuid())
  mockTestSessionId String          @unique
  mockTestSession   MockTestSession @relation(fields: [mockTestSessionId], references: [id], onDelete: Cascade)

  summary      String
  strengths    String // JSON array of { point, evidence }
  improvements String // JSON array of { point, evidence, tip }

  analysisProvider String
  analysisModel    String
  estimatedCostUsd Float

  createdAt DateTime @default(now())
}

// One ongoing text chat thread per candidate with the Personal AI Coach
// (Phase 15) - not per-session like ConversationSession, since the coach's
// whole point is to reason across the candidate's real history. Every
// "coach" row is a real paid AI turn-based reply, grounded in the real
// aggregate stats from src/lib/coach-profile.ts (computed free, from
// already-persisted ScoreReport rows) - never a fabricated insight.
model CoachMessage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role    String // "user" | "coach"
  content String

  analysisProvider String?
  analysisModel    String?
  estimatedCostUsd Float?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Configurable assessment structure - "allow the test configuration to
// change the sections" (Phase 12). Editing sections is a data change here,
// not a code change; Phase 17's admin UI can manage these rows directly
// once it exists.
model MockTestTemplate {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Explicit admin choice of which template new mock-test sessions use -
  // replaces the old implicit "whichever template was created most
  // recently" behavior. At most one row has this set to true at a time,
  // enforced in application code (src/app/api/admin/templates) rather
  // than a DB constraint, since Postgres partial-unique-index syntax isn't
  // worth the extra migration complexity for a single admin-managed table.
  isDefault Boolean @default(false)

  // Optional link to a specific exam structure (P1-A). Null means today's
  // behaviour exactly: a generic template with no external exam scale or
  // fixed paper/part shape - every existing template stays null forever
  // unless an admin explicitly attaches one to a real ExamVariant.
  examVariantId String?
  examVariant   ExamVariant? @relation(fields: [examVariantId], references: [id])

  sections MockTestTemplateSection[]
  sessions MockTestSession[]
}

model MockTestTemplateSection {
  id            String            @id @default(cuid())
  templateId    String
  template      MockTestTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  order         Int
  category      String
  difficulty    String
  questionCount Int

  // Optional link to the specific ExamPart this section represents (P1-A).
  // Null means today's behaviour exactly: a plain category/difficulty
  // section with no external paper/part structure.
  examPartId String?
  examPart   ExamPart? @relation(fields: [examPartId], references: [id])

  @@index([templateId, order])
}

// P1-A: the exam catalogue. Four levels, matching how real language/
// employment exams are actually structured: a family of exam styles
// (IELTS_STYLE, ...), a specific variant within it (Academic, General
// Training, ...), that variant's papers (Listening, Reading, ...), and
// each paper's parts. Nothing here is wired into any existing flow yet -
// MockTestTemplate/-Section only gain an OPTIONAL pointer into this
// catalogue, so every current template/session keeps behaving exactly as
// it does today (null variant/part) until an admin deliberately attaches
// one.
model ExamFamily {
  id          String  @id @default(cuid())
  slug        String  @unique // IELTS_STYLE | SELT_STYLE | PTE_STYLE | CAMBRIDGE_STYLE | APTITUDE | EMPLOYMENT | GENERAL_ENGLISH
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())

  variants ExamVariant[]

  @@index([isActive])
}

model ExamVariant {
  id       String     @id @default(cuid())
  familyId String
  family   ExamFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  slug String // unique within its family, not globally - e.g. both IELTS_STYLE and SELT_STYLE could plausibly have an "ACADEMIC"-shaped variant
  name String // e.g. "Academic", "General Training", "Life Skills A1", "UKVI 4-skill"

  // Key into src/lib/score-scales/ (P1-F) - e.g. "IELTS_STYLE_BAND",
  // "CEFR". A plain string, not a relation, for the same
  // registry-validated-in-TS reason as PracticeQuestion.category.
  scoreScale String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  papers            ExamPaper[]
  mockTestTemplates MockTestTemplate[]

  @@unique([familyId, slug])
  @@index([isActive])
}

model ExamPaper {
  id        String      @id @default(cuid())
  variantId String
  variant   ExamVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  order        Int
  name         String // e.g. "Listening", "Reading", "Writing", "Speaking", "Numerical Reasoning"
  durationSeconds Int
  instructions String? // markdown, shown before the paper starts

  // "LOCKED_SEQUENTIAL" (answer in order, no going back once submitted -
  // the shape most real timed language-test papers use) |
  // "FREE_WITHIN_SECTION" (jump between questions freely until the paper
  // itself is submitted). Plain string validated in exam-catalogue.ts,
  // same reason as everywhere else in this schema.
  navigationMode String @default("LOCKED_SEQUENTIAL")
  allowReview    Boolean @default(false)

  parts ExamPart[]

  @@index([variantId, order])
}

model ExamPart {
  id      String    @id @default(cuid())
  paperId String
  paper   ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  order        Int
  name         String
  instructions String?

  // Only meaningful for a speaking-style part (P1-E's TIMED_SPEAKING
  // question type) - null for every other part.
  prepSeconds     Int?
  responseSeconds Int?

  mockTestTemplateSections MockTestTemplateSection[]

  @@index([paperId, order])
}

// A single proctoring flag - a signal requiring human interpretation, never
// an automatic accusation. eventType is a plain string validated against
// src/lib/proctoring-events.ts, for the same SQLite-has-no-enums reason as
// PracticeQuestion.category.
model ProctoringEvent {
  id         String          @id @default(cuid())
  sessionId  String
  session    MockTestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType  String
  detail     String?
  occurredAt DateTime        @default(now())

  @@index([sessionId, occurredAt])
}

// A turn-based (not real-time streaming) AI voice roleplay - the candidate
// speaks, the AI replies in character, repeat. role picks the persona and
// which question category seeds the opening scenario. The first AI turn is
// just the seeded question's own text (no AI call needed); only later AI
// turns are actually generated live.
model ConversationSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role       String // CUSTOMER | INTERVIEWER | SUPERVISOR | CONVERSATION_PARTNER
  questionId String?
  question   PracticeQuestion? @relation(fields: [questionId], references: [id])

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  overallAnalysisJson String? // null until the candidate ends the conversation and analysis runs

  turns ConversationTurn[]

  @@index([userId, startedAt])
}

model ConversationTurn {
  id        String              @id @default(cuid())
  sessionId String
  session   ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  turnIndex Int
  speaker   String // "ai" | "candidate"
  text      String

  recordingId String? // only set for candidate turns
  recording   PracticeRecording? @relation(fields: [recordingId], references: [id])

  // Captured from the transcription call at turn-creation time (candidate
  // turns only) so a later deep analysis (Phase 11) can compute real WPM/
  // filler/pause metrics without re-transcribing and re-paying for it.
  durationSeconds Float?
  segmentsJson    String?

  createdAt DateTime @default(now())

  @@index([sessionId, turnIndex])
}

// One row per candidate - their commercial plan. Every user gets a FREE
// subscription lazily (src/lib/entitlements.ts creates one on first check
// if missing), so there's exactly one code path for "what plan is this
// user on" regardless of whether they signed up before or after paid
// plans existed. currentPeriodEnd is null for FREE (its limits are
// lifetime, not monthly) and set for paid plans; a paid plan whose period
// has lapsed is treated as FREE by the entitlements layer, not deleted -
// this keeps their lifetime FREE usage history intact and correct.
// Assigned manually by an admin for now (no payment processor is wired up
// yet) - the same field a future billing webhook will write to.
model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   String @default("FREE") // FREE | STARTER | PROFESSIONAL | PREMIUM
  status String @default("ACTIVE") // ACTIVE | EXPIRED | CANCELED

  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?

  // Set once a real Paddle checkout completes (src/app/api/webhooks/paddle) -
  // null for every FREE user and every plan an admin assigned manually
  // before payments existed. paddleSubscriptionId is how renewal/cancel
  // webhooks for an existing subscription are matched back to this row.
  paddleCustomerId     String?
  paddleSubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A real, append-only log of one gated action - never a mutable counter,
// so "how much has this user used" is always a real count of real rows,
// the same discipline as every score in this app. Limits are enforced by
// counting rows in the current billing window (or all-time for FREE) -
// see src/lib/entitlements.ts. feature is a plain string validated there,
// for the same SQLite-has-no-enums reason used throughout this schema.
model UsageEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  feature String // PRACTICE_SESSION | VOICE_RECORDING | SPEECH_ANALYSIS | IMPROVE_ANSWER | COACH_MESSAGE | MOCK_ASSESSMENT | INTERVIEW_SIMULATION | AI_SCENARIO

  createdAt DateTime @default(now())

  @@index([userId, feature, createdAt])
}

// Master on/off switch for one feature (a practice category, or a named
// subsystem like MOCK_TEST) - enforced server-side in the API routes that
// serve that feature (src/lib/feature-flags.ts), never just hidden in the
// UI. `key` is validated against a fixed catalog at the app layer (same
// plain-string-not-enum reason as PracticeQuestion.category) so a typo in
// an admin request can't silently create an unenforced flag. A row that
// doesn't exist yet means "enabled" (fail-open) - a feature works normally
// until an admin explicitly touches it.
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// Append-only record of administrative actions - question/feature/template/
// user/settings changes. Deliberately NOT related to User by a foreign key:
// an audit trail must survive even if the admin account that made the
// change is later deleted, so adminId/adminEmail are a plain snapshot, not
// a live relation. before/afterJson are optional since not every action
// has a meaningful before/after state (e.g. "question deleted" only needs
// beforeJson).
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  action     String
  targetType String?
  targetId   String?
  beforeJson String?
  afterJson  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}

// Admin-tunable weight for one scoring category's contribution to a mock
// test's overall Readiness score (src/lib/scoring-engine.ts). A missing
// row means weight 1 (today's plain-average behavior) - same fail-open
// pattern as FeatureFlag, so nothing changes until an admin actually
// adjusts a weight. `category` is validated against SCORE_CATEGORIES at
// the app layer (src/lib/scoring-config.ts), the same plain-string
// discipline used throughout this schema.
model ScoringCategoryWeight {
  id        String   @id @default(cuid())
  category  String   @unique
  weight    Float    @default(1)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Fixed-window rate limiting, backed by Postgres rather than in-memory
// state - this app runs as serverless functions (Vercel), where in-memory
// counters would reset per cold start and never be shared across
// concurrent instances, making them useless for real protection. `key`
// identifies what's being limited (e.g. "login:ip:1.2.3.4" or
// "login:email:someone@example.com"); `windowStart` is the current
// window's start time truncated to the window size, so a new window is
// just a new row rather than something that needs a cleanup job to reset.
// Old rows are harmless clutter, not a correctness issue - can be swept
// periodically, but nothing depends on that happening.
model RateLimitHit {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@unique([key, windowStart])
  @@index([key, windowStart])
}

// A single-use, expiring token for the forgot-password flow. tokenHash
// stores a SHA-256 hash of the token, never the raw value - the same
// reason passwords are hashed, since anyone with DB read access should
// not be able to reset an account just by reading this table. usedAt is
// set the moment a token is redeemed so it can never be replayed, even
// within its expiry window.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}
