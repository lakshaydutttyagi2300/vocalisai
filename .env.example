# Copy this file to .env and fill in real values in your own editor.
# Never paste real keys anywhere shared (chat, tickets, screenshots, GitHub -
# this repository is public). See docs/SERVICES_AND_SECRETS.md for each value.
#
# This is also the checklist of every env var to set in Vercel's project
# settings before deploying - same names, same meaning, production values.

GROQ_API_KEY=
GEMINI_API_KEY=

# Postgres, hosted on Neon. Use the "development" branch here, NOT
# "production" - Vercel's production env vars point at "production"
# instead. Keeping them separate means local testing can never write
# fake/test rows into the real database real candidates use. Get the
# connection string from the Neon dashboard -> your project -> pick the
# branch -> Connection Details (or `neon connection-string --branch
# development` with the Neon CLI linked to this directory).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# The same branch's DIRECT (non-pooled) connection string: used by migrations,
# and by src/lib/db.ts as a fallback if DATABASE_URL is ever missing.
# (POSTGRES_URL / POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING, set by the
# Vercel-Neon integration, are accepted as last-resort fallbacks too.)
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Email: sign-up verification codes and password resets (src/lib/email.ts).
# SMTP is used when SMTP_HOST, SMTP_USER and SMTP_PASSWORD are set - e.g. a
# Gmail account (free, ~500 emails/day): turn on 2-Step Verification, then
# create an App Password at https://myaccount.google.com/apppasswords.
# REQUIRED in production: without a working sender nobody can sign up.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Optional sender, e.g. "VocalisAi <you@gmail.com>" (defaults to SMTP_USER).
EMAIL_FROM=
# Optional: force one path - smtp | resend | log (log = server console only;
# the e2e tests use it). Unset = SMTP if configured, else Resend, else log.
# EMAIL_DELIVERY=

# Resend (alternative sender). Without a verified domain it can only deliver
# to the Resend account owner's own address - not usable for candidates.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Paddle (payment processor - Merchant of Record). NEXT_PUBLIC_ vars are
# safe to expose to the browser (Paddle.js needs them there to open
# checkout) - only PADDLE_WEBHOOK_SECRET must stay server-only.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_STARTER=
NEXT_PUBLIC_PADDLE_PRICE_PROFESSIONAL=
NEXT_PUBLIC_PADDLE_PRICE_PREMIUM=
PADDLE_WEBHOOK_SECRET=

# Cloudflare R2 (voice recording storage). Without these set, recordings
# are written to/read from local disk under uploads/ - fine for local dev,
# but local disk does NOT persist across deploys on Vercel, so production
# MUST have these set before real recordings are at stake. Create a bucket
# at https://dash.cloudflare.com -> R2, and an API token scoped to it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Natural voices (ElevenLabs) - SERVER ONLY, never NEXT_PUBLIC_.
# Without a key everything still works with the device's own voice.
ELEVENLABS_API_KEY=
# Optional: model (default eleven_flash_v2_5, the cheapest), credits kept in
# reserve (default 1000), and per-accent voice overrides (IN/US/UK x F/M).
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# ELEVENLABS_RESERVE_CREDITS=1000
# ELEVENLABS_VOICE_IN_F=
# ELEVENLABS_VOICE_IN_M=
