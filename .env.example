# Copy this file to .env and fill in real values in your own editor.
# Never paste real keys into chat - Claude does not need to see the raw values,
# only that the .env file exists and is readable at runtime.
#
# This is also the checklist of every env var to set in Vercel's project
# settings before deploying - same names, same meaning, production values.

GROQ_API_KEY=
GEMINI_API_KEY=

# Postgres, hosted on Neon. Use the "development" branch here, NOT
# "production" - Vercel's production env vars point at "production"
# instead. Keeping them separate means local testing can never write
# fake/test rows into the real database real candidates use. Get the
# connection string from the Neon dashboard -> your project -> pick the
# branch -> Connection Details (or `neon connection-string --branch
# development` with the Neon CLI linked to this directory).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Resend (password reset emails). Without this set, reset links are logged
# to the server console instead of emailed - fine for local dev, not for
# production. Get a key at https://resend.com, and set RESEND_FROM_EMAIL to
# an address on a domain you've verified with Resend before going live.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Paddle (payment processor - Merchant of Record). NEXT_PUBLIC_ vars are
# safe to expose to the browser (Paddle.js needs them there to open
# checkout) - only PADDLE_WEBHOOK_SECRET must stay server-only.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_STARTER=
NEXT_PUBLIC_PADDLE_PRICE_PROFESSIONAL=
NEXT_PUBLIC_PADDLE_PRICE_PREMIUM=
PADDLE_WEBHOOK_SECRET=

# Cloudflare R2 (voice recording storage). Without these set, recordings
# are written to/read from local disk under uploads/ - fine for local dev,
# but local disk does NOT persist across deploys on Vercel, so production
# MUST have these set before real recordings are at stake. Create a bucket
# at https://dash.cloudflare.com -> R2, and an API token scoped to it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
