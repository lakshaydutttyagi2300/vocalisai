# Copy this file to .env and fill in real values in your own editor.
# Never paste real keys into chat - Claude does not need to see the raw values,
# only that the .env file exists and is readable at runtime.

GROQ_API_KEY=
GEMINI_API_KEY=

# SQLite for local dev - zero cost. Swap to a Postgres URL for production.
DATABASE_URL="file:./dev.db"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
