# Copy this to .env.test and fill in a Neon branch connection string.
# MUST point at a disposable test branch, never at "development" or
# "production" - the unit/e2e suites create, mutate and delete real rows
# freely (accounts, attempts, questions) and assume they have the whole
# database to themselves.
#
# Recommended: a Neon branch created FROM "development" (Neon dashboard ->
# Branches -> Create branch -> parent "development"), reset or recreated
# whenever it accumulates too much test data. Never point this at the same
# branch you use for manual QA or admin testing.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Any fixed value works - tests don't depend on the real production secret.
NEXTAUTH_SECRET="test-secret-not-for-production-use-only-in-automated-tests"
NEXTAUTH_URL="http://localhost:3000"
